        ('2020-01-01'::date, 'Nouvel An'), ('2020-05-01'::date, 'Fête du Travail'), ('2020-05-08'::date, 'Victoire 1945'),
        ('2020-07-14'::date, 'Fête Nationale'), ('2020-08-15'::date, 'Assomption'), ('2020-11-01'::date, 'Toussaint'),
