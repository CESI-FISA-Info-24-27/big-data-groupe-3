    create  table
      "staging"."staging_staging"."stg_date__dbt_tmp"
  
    as (
      

-- Nettoyage et standardisation de la dimension dates
-- Source pour compléter dim_temps si nécessaire
with source as (
    select * from "staging"."raw"."date"
),

cleaned as (
    select
        -- Dates (2 colonnes dans raw: date1 et date2)
        cast(date1 as date) as date1,
        cast(date2 as date) as date2,
        
        -- Informations calculées sur date1
        date_part('year', cast(date1 as date)) as annee,
        date_part('month', cast(date1 as date)) as mois,
        date_part('day', cast(date1 as date)) as jour,
        
        -- Métadonnées
        current_timestamp as loaded_at
        
    from source
    where date1 is not null
)

select * from cleaned
    );
  
  
