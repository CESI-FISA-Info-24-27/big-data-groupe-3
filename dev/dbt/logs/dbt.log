    create  table
      "staging"."staging_staging"."stg_hospitalisation__dbt_tmp"
  
    as (
      

-- Nettoyage et standardisation des hospitalisations
-- Prépare les données pour fait_hospitalisation
with source as (
    select * from "staging"."raw"."hospitalisation_hospitalisations"
),

cleaned as (
    select
        -- Identifiants
        cast(num_hospitalisation as integer) as num_hospitalisation,
        cast(id_patient as integer) as id_patient,
        trim(finess) as finess,
        
        -- Dates
        cast(date_admission as date) as date_admission,
        cast(date_sortie as date) as date_sortie,
        
        -- Calcul durée séjour en jours
        date_part('day', cast(date_sortie as date) - cast(date_admission as date)) as jour_hospitalisation,
        
        -- Diagnostic
        trim(code_diagnostic) as code_diagnostic,
        
        -- Salle
        cast(id_salle as integer) as id_salle,
        
        -- Métadonnées
        current_timestamp as loaded_at
        
    from source
    where num_hospitalisation is not null
      and id_patient is not null
      and date_admission is not null
)

select * from cleaned
    );
  
  
