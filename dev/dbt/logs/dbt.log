    create  table
      "staging"."staging"."ods_patient_complet__dbt_tmp"
  
    as (
      

-- Patient enrichi avec informations mutuelle
-- Prépare les données pour dim_patient
with patients as (
    select * from "staging"."staging"."stg_patient"
),

adhesions as (
    select * from "staging"."staging"."stg_adher"
),

mutuelles as (
    select * from "staging"."staging"."stg_mutuelle"
),

patient_mutuelle as (
    select
        p.*,
        
        -- Informations mutuelle (LEFT JOIN car tous les patients n'ont pas forcément de mutuelle)
        m.id_mut,
        m.nom_mutuelle,
        m.type_mutuelle,
        a.statut_adhesion,
        
        -- Calcul si patient a une mutuelle active
        case
            when m.id_mut is not null and a.statut_adhesion = 'ACTIF' then true
            else false
        end as a_mutuelle_active
        
    from patients p
    left join adhesions a on p.id_patient = a.id_patient
    left join mutuelles m on a.id_mut = m.id_mut
)

select * from patient_mutuelle
    );
  
  
[0m11:23:40.327797 [debug] [Thread-1 (]: On model.chu_datawarehouse.ods_deces_enrichi: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "chu_dwh", "target_name": "dev", "node_id": "model.chu_datawarehouse.ods_deces_enrichi"} */

  
    
    

    create  table
      "staging"."staging"."ods_deces_enrichi__dbt_tmp"
  
    as (
      

-- Décès enrichis avec calculs et classifications
-- Prépare les données pour fait_deces (25M+ lignes)
with deces as (
    select * from "staging"."staging"."stg_deces"
),

deces_enrichi as (
    select
        -- Identifiants
        numero_acte_deces,
        
        -- Dates
        date_deces,
        date_naissance,
        
        -- Âge au décès
        age_deces,
        
        -- Classification par âge
        case
            when age_deces < 1 then 'MOINS_1_AN'
            when age_deces between 1 and 18 then 'ENFANT'
            when age_deces between 19 and 30 then 'JEUNE_ADULTE'
            when age_deces between 31 and 65 then 'ADULTE'
            when age_deces > 65 then 'SENIOR'
            else 'NON_RENSEIGNE'
        end as tranche_age_deces,
        
        -- Sexe
        case
            when sexe_code = 1 then 'M'
            when sexe_code = 2 then 'F'
            else 'INCONNU'
        end as sexe,
        
        -- Localisation décès
        code_lieu_deces,
        
        -- Localisation naissance
        code_lieu_naissance,
        lieu_naissance,
        pays_naissance,
        
        -- Identité (pour matching éventuel)
        nom,
        prenom,
        
        -- Métadonnées
        loaded_at
        
    from deces
    where date_deces is not null  -- Filtrer dates invalides
)

select * from deces_enrichi
    );
  
  
[0m11:23:40.328122 [debug] [Thread-4 (]: On model.chu_datawarehouse.ods_professionnel_complet: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "chu_dwh", "target_name": "dev", "node_id": "model.chu_datawarehouse.ods_professionnel_complet"} */

  
    
    

    create  table
      "staging"."staging"."ods_professionnel_complet__dbt_tmp"
  
    as (
      

-- Professionnel enrichi avec établissement et spécialité
-- Prépare les données pour dim_professionnel (SCD Type 2)
with professionnels as (
    select * from "staging"."staging"."stg_professionnel_sante"
),

etablissements_pro as (
    select * from "staging"."staging"."stg_etablissement_professionnel"
),

specialites as (
    select * from "staging"."staging"."stg_specialites"
),

-- Agréger les informations par professionnel
professionnel_enrichi as (
    select
        p.*,
        
        -- Informations établissement (prendre le plus récent ou un au hasard)
        max(ep.commune) as commune_exercice,
        max(ep.specialite) as specialite_exercice,
        
        -- Déterminer mode d'exercice
        case
            when p.categorie_professionnelle like '%Libéral%' then 'Libéral'
            when p.categorie_professionnelle like '%Salarié%' or p.categorie_professionnelle like '%Salarie%' then 'Salarié'
            else 'Non renseigné'
        end as mode_exercice,
        
        -- Compter nombre d'établissements
        count(distinct ep.commune) as nb_etablissements
        
    from professionnels p
    left join etablissements_pro ep on p.identifiant = ep.identifiant
    group by
        p.identifiant,
        p.civilite,
        p.nom,
        p.prenom,
        p.profession,
        p.categorie_professionnelle,
        p.code_specialite,
        p.type_identifiant,
        p.loaded_at
)

select * from professionnel_enrichi
    );
  
  
