    create  table
      "staging"."staging_staging"."stg_patient__dbt_tmp"
  
    as (
      

-- Nettoyage et standardisation des données patients
-- Prépare les données pour dim_patient
with source as (
    select * from "staging"."raw"."patient"
),

cleaned as (
    select
        -- Business Key
        cast(id as integer) as id_patient,
        
        -- Informations personnelles
        trim(upper(nom)) as nom,
        trim(upper(prenom)) as prenom,
        upper(sexe) as sexe,
        cast(date_naissance as date) as date_naissance,
        
        -- Calculs d'âge
        date_part('year', age(current_date, cast(date_naissance as date))) as age,
        case
            when date_part('year', age(current_date, cast(date_naissance as date))) < 18 then '0-18'
            when date_part('year', age(current_date, cast(date_naissance as date))) between 19 and 30 then '19-30'
            when date_part('year', age(current_date, cast(date_naissance as date))) between 31 and 50 then '31-50'
            when date_part('year', age(current_date, cast(date_naissance as date))) between 51 and 65 then '51-65'
            else '66+'
        end as tranche_age,
        
        -- Informations médicales
        upper(groupe_sanguin) as groupe_sanguin,
        cast(poids as decimal(5,2)) as poids,
        cast(taille as integer) as taille,
        
        -- Localisation
        trim(code_postal) as code_postal,
        trim(upper(ville)) as ville,
        coalesce(pays, 'FR') as pays,
        
        -- Sécurité sociale (à pseudonymiser dans dim_patient)
        num_secu,
        
        -- Référence mutuelle
        mutuelle_id,
        
        -- Métadonnées
        current_timestamp as loaded_at
        
    from source
    where id is not null  -- Filtrer les lignes sans ID
)

select * from cleaned
    );
  
  
