            then 'ACTIF'
            else 'INACTIF'
        end as statut_adhesion,
        
        -- Métadonnées
        current_timestamp as loaded_at
        
    from source
    where id_patient is not null
      and id_mut is not null
)

select * from cleaned
    );
  
  
