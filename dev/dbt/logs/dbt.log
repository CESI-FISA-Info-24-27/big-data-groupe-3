        ('2019-01-01'::date, 'Nouvel An'), ('2019-05-01'::date, 'Fête du Travail'), ('2019-05-08'::date, 'Victoire 1945'),
        ('2019-07-14'::date, 'Fête Nationale'), ('2019-08-15'::date, 'Assomption'), ('2019-11-01'::date, 'Toussaint'),
