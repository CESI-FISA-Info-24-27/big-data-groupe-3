    create  table
      "staging"."staging_staging"."stg_date__dbt_tmp"
  
    as (
      

-- Nettoyage et standardisation de la dimension dates
-- Source pour compléter dim_temps si nécessaire
with source as (
    select * from "staging"."raw"."date"
),

cleaned as (
    select
        -- Date
        cast(date_complete as date) as date_complete,
        
        -- Informations calculées
        date_part('year', cast(date_complete as date)) as annee,
        date_part('month', cast(date_complete as date)) as mois,
        date_part('day', cast(date_complete as date)) as jour,
        
        -- Métadonnées
        current_timestamp as loaded_at
        
    from source
    where date_complete is not null
)

select * from cleaned
    );
  
  
