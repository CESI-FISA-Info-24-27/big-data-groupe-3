    create  table
      "staging"."staging_staging"."stg_specialites__dbt_tmp"
  
    as (
      

-- Nettoyage et standardisation des spécialités médicales
-- Prépare les données pour dim_specialite
with source as (
    select * from "staging"."raw"."specialites"
),

cleaned as (
    select
        -- Business Key
        trim(code_specialite) as code_specialite,
        
        -- Informations spécialité
        trim(fonction) as fonction,
        trim(specialite) as specialite,
        
        -- Classification
        case
            when lower(specialite) like '%général%' then 'Médecine générale'
            when lower(specialite) like '%chirurg%' then 'Chirurgie'
            when lower(specialite) like '%psychiatr%' then 'Psychiatrie'
            else 'Médecine spécialisée'
        end as categorie,
        
        -- Métadonnées
        current_timestamp as loaded_at
        
    from source
    where code_specialite is not null
)

select * from cleaned
    );
  
  
