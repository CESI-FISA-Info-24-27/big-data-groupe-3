with source as (
    select * from "staging"."raw"."etablissement_de_sante_professionnel_sante"
),

cleaned as (
    select
        -- Identifiant professionnel
        trim(identifiant) as identifiant,  -- RPPS/ADELI
        
        -- Informations personnelles
