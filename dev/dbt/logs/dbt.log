    as (
      

-- Consolidation de toutes les tables satisfaction e-Satis (2014-2020)
-- Prépare les données pour fait_satisfaction

-- Note: Les tables satisfaction ont des structures différentes selon les années
-- On fait un mapping vers une structure unifiée

with satisfaction_2019_esatis48h as (
    select
        'E-SATIS 48h MCO' as type_enquete,
        2019 as annee_enquete,
        2019 as annee_donnee,
        *
    from "staging"."raw"."satisfaction_2019_resultats_esatis48h_mco_open_data_2019"
),

satisfaction_2019_esatisca as (
    select
        'E-SATIS CA MCO' as type_enquete,
        2019 as annee_enquete,
        2019 as annee_donnee,
        *
    from "staging"."raw"."satisfaction_2019_resultats_esatisca_mco_open_data_2019"
),

satisfaction_2017_esatis48h as (
    select
        'E-SATIS 48h MCO' as type_enquete,
        2017 as annee_enquete,
        2017 as annee_donnee,
        *
    from "staging"."raw"."satisfaction_esatis48h_mco_recueil2017_donnees"
),

-- Union de toutes les sources satisfaction
all_satisfaction as (
    select * from satisfaction_2019_esatis48h
    union all
    select * from satisfaction_2019_esatisca
    union all
    select * from satisfaction_2017_esatis48h
)

select
    *,
    current_timestamp as loaded_at
from all_satisfaction
    );
  
  
