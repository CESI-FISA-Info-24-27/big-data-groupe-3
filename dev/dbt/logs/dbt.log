        -- Business key
        id_mut,
        
        -- Attributs descriptifs
        nom_mutuelle,
        adresse,
        type_mutuelle,  -- CMU, Assurance, Mutuelle (calculé dans staging)
        
        -- Métadonnées
        loaded_at as date_chargement
        
    from mutuelles_source
)

select * from dimension_mutuelle
order by sk_mutuelle
    );
  
  
