# ============================================
# .gitignore - CHU Data Warehouse
# ============================================

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv

# PyCharm
.idea/

# VS Code
.vscode/
*.code-workspace

# ============================================
# DuckDB
# ============================================
*.duckdb
*.duckdb.wal
data/duckdb/*.duckdb
data/duckdb/*.duckdb.wal
data/duckdb/*.duckdb.old

# Sauf si vous voulez versionner une DB de référence
# !data/duckdb/reference.duckdb

# ============================================
# DBT
# ============================================
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml
dbt/package-lock.yml

# Logs dbt racine
logs/dbt.log

# ============================================
# Airflow
# ============================================
logs/
airflow.db
airflow.cfg
standalone_admin_password.txt
webserver_config.py

# Répertoires Airflow générés
dags/__pycache__/
config/

# ============================================
# Données
# ============================================

# Fichiers de données volumineux (optionnel)
# Décommenter si vous ne voulez pas versionner les CSV
data/csv/*


# Exports temporaires
data/export_parquet/
*.parquet

# ============================================
# Credentials et Configuration
# ============================================

# Fichiers d'environnement (IMPORTANT!)
.env
.env.local
.env.*.local
.env.airflow

# Sauf les templates
!.env.example
!.env.template

# Credentials
credentials.json
secrets/
*.key
*.pem

# ============================================
# Système
# ============================================

# MacOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ============================================
# Temporaires
# ============================================

# Fichiers temporaires
*.tmp
*.temp
*.swp
*.swo
*~
.~*

# Fichiers Excel temporaires
~$*.xlsx
~$*.xls

# Logs
*.log
logs/*.log

# ============================================
# Tests
# ============================================

# Coverage
.coverage
htmlcov/
.pytest_cache/
.tox/

# ============================================
# Docker
# ============================================

# Volumes Docker (gérés par docker-compose)
# Les volumes nommés sont persistants automatiquement

# ============================================
# Documentation
# ============================================

# Fichiers générés
*.pdf
*.docx

# Sauf les livrables finaux
!docs/livrables/*.pdf
!docs/livrables/*.docx

# ============================================
# Divers
# ============================================

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/

# SQLite
*.sqlite
*.db

# Backups
*.bak
*.backup
*.old

